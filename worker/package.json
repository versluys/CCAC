{
  "name": "ccac-sitefinder-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:create": "wrangler d1 create ccac-sitefinder",
    "db:schema": "wrangler d1 execute ccac-sitefinder --file=schema.sql --remote",
    "db:seed": "for f in seed/*.sql; do wrangler d1 execute ccac-sitefinder --file=$f --remote || exit 1; done",
    "db:schema:local": "wrangler d1 execute ccac-sitefinder --file=schema.sql --local --env dev",
    "db:seed:local": "for f in seed/*.sql; do wrangler d1 execute ccac-sitefinder --file=$f --local --env dev || exit 1; done"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
